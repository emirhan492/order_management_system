# PostgreSQL bağlantısı (sslmode=verify-full önerilir)
DATABASE_URL=postgresql://kullanici:sifre@host/veritabani?sslmode=verify-full

# Panel giriş PIN'i (en az 6, tercihen 8+ hane)
ADMIN_PIN=

# Uzun ve rastgele bir değer: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Cloudinary (Dashboard > API Keys sayfasındaki "API environment variable")
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Görsellerin yükleneceği klasör (varsayılan: papatya)
CLOUDINARY_FOLDER=papatya

# Reverse proxy (Render, Railway, Nginx...) arkasında çalışıyorsa 1 yapın
TRUST_PROXY=

PORT=3000

# Keep-alive: Render'da RENDER_EXTERNAL_URL otomatik gelir, ek ayar gerekmez.
# Başka bir yerde barındırıyorsanız sitenin dış adresini yazın (örn. https://ornek.onrender.com)
KEEP_ALIVE_URL=
# Ping aralığı (dakika). Render 15 dk hareketsizlikte uyuttuğu için 15'ten küçük olmalı.
KEEP_ALIVE_DAKIKA=10
# Pinglemeyi kapatmak için 0 yapın
KEEP_ALIVE=
